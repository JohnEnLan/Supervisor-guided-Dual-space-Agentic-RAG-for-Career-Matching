# 复制成 .env 并填真实值。不要把 .env 提交到 git。

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/career_rag
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- W3 authentication (compatibility mode defaults) ---
APP_ENV=development
AUTH_SECRET_KEY=replace-with-an-independent-random-string-at-least-32-bytes
OTP_PEPPER=replace-with-another-independent-random-string-at-least-32-bytes
AUTH_SESSION_TTL_DAYS=7
AUTH_ENFORCED=false

# Email provider: console | smtp | disabled. Console is development/test only.
EMAIL_OTP_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_START_TLS=true
# SMS provider: console | disabled. Production may use SMTP email with SMS
# disabled; at least one channel must remain enabled, and console is forbidden.
SMS_OTP_PROVIDER=console

# --- DeepSeek (OpenAI 兼容) ---
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以 DeepSeek 官方文档为准，这里只是占位
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner

# --- Qwen Embedding (DashScope) ---
QWEN_API_KEY=sk-xxx
# 必须与语料 embedding 指纹一致（当前演示语料 = text-embedding-v4）。
# 在线服务启动不做查询模型×语料指纹交叉校验，配错会静默劣化召回；
# 导入流程有指纹强校验会直接报错。
QWEN_EMBED_MODEL=text-embedding-v4
# 重要：必须与 pgvector 列维度一致（schema.sql 里的 vector(N)）
EMBED_DIM=1024

# --- Cross-encoder rerank (DashScope Text Rerank) ---
RERANK_ENABLED=false
RERANK_MODEL=gte-rerank-v2
# Workspace endpoint (current documented shape; replace WorkspaceId):
RERANK_ENDPOINT=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# Legacy public endpoint; availability must be confirmed by the probe:
# RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_TOP_N=20
RERANK_TIMEOUT_SECONDS=5
RERANK_MAX_CONCURRENCY=4
RERANK_DOC_MAX_CHARS=1500
RERANK_QUERY_MAX_CHARS=600

# --- 并发限流 ---
LLM_MAX_CONCURRENCY=5
# 单次 LLM user prompt 的字符预算；超限时保留合法 JSON 和截断元数据
LLM_USER_PROMPT_MAX_CHARS=60000
EMBED_MAX_CONCURRENCY=8

# --- Correct dual-space retrieval ---
DUAL_SPACE_ENABLED=true
IMPLICIT_MIN_CASES=3
IMPLICIT_MAX_WEIGHT=0.30
IMPLICIT_CASE_TOP_K=20

# --- Examiner-only public explain endpoint ---
EVALUATION_CAPABILITY_ENABLED=false

# --- Privacy-safe read-only monitoring page ---
MONITORING_ENABLED=false
# When true, /monitoring/* additionally requires an authenticated is_admin user.
# A false value is only for an isolated local/loopback examiner deployment;
# production rejects MONITORING_ENABLED=true without admin mode.
MONITORING_ADMIN_MODE=false
DEMO_CORPUS_ENABLED=false

# --- LangGraph orchestration (default); set false to roll back to the legacy orchestrator ---
LANGGRAPH_ORCHESTRATOR_ENABLED=true
# Periodic stale-run/checkpoint cleanup; set 0 to disable the background sweep.
# Checkpoint deserialization safety is enforced by the explicit type
# allowlist in app/api/main.py, not by an environment switch.
CHECKPOINT_SWEEP_INTERVAL_SECONDS=3600

# --- Bounded loops ---
MAX_CLARIFICATION_LOOPS=1
MAX_CONSULT_ROUNDS=8
MAX_RERETRIEVAL_LOOPS=1
MAX_REPAIR_LOOPS=1

# 跨机器 http 演示（答辩投屏以外的场景）才需要打开：
# __Host- Cookie 强制 Secure，浏览器只对 localhost 豁免；true 时改发无前缀
# app_session Cookie（不带 Secure）。仅限 development/test，production 拒绝启动。
AUTH_COOKIE_INSECURE=false

# 每账号会话（对话）额度，超出返回 402 由前端展示付费墙
SESSION_QUOTA_PER_USER=3

# RAPTOR 检索通道（与 RERANK_ENABLED 同开为消融最优组合）
RAPTOR_ENABLED=false
