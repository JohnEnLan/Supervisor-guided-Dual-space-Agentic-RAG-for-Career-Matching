[Unit]
Description=Career-RAG FastAPI backend
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=career
Group=career
WorkingDirectory=/opt/career-rag/app
EnvironmentFile=/opt/career-rag/app/.env
ExecStart=/opt/career-rag/venv/bin/python -m app.serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
