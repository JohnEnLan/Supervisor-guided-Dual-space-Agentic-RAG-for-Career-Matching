# Career-RAG 生产 .env 模板（字段名与 app/config.py 逐一对应）
# 带 <<>> 的必须替换；其余按需调整。实际部署时 Claude 会在本机组装真值版。

# --- 数据库（密码用 server_setup.sh 第 4 步打印的那个）---
DATABASE_URL=postgresql://career:<<DB_PASS>>@localhost:5432/career_rag
DB_POOL_MIN=2
DB_POOL_MAX=8

# --- 生产模式（触发启动安全校验：秘钥长度、OTP provider、演示语料开关）---
APP_ENV=production
AUTH_ENFORCED=true
AUTH_SECRET_KEY=<<openssl rand -hex 32 生成，≥32字节，禁止复用本机值>>
OTP_PEPPER=<<openssl rand -hex 32 再生成一个，与上面不同>>
AUTH_SESSION_TTL_DAYS=30
SESSION_QUOTA_PER_USER=3

# --- 邮件验证码（QQ SMTP；授权码答辩前记得轮换）---
EMAIL_OTP_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=<<你的QQ邮箱>>
SMTP_PASSWORD=<<QQ授权码>>
SMTP_FROM_EMAIL=<<你的QQ邮箱>>
# 生产禁止 console provider，短信通道必须显式关闭
SMS_OTP_PROVIDER=disabled

# --- 数据库快照含 demo_synthetic 语料时，生产启动强制要求此开关 ---
DEMO_CORPUS_ENABLED=true

# --- LLM 与 Embedding（从本机 .env 抄真实 key）---
DEEPSEEK_API_KEY=<<你的key>>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner
QWEN_API_KEY=<<你的key>>
QWEN_EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# --- 并发与回路上限 ---
LLM_MAX_CONCURRENCY=5
EMBED_MAX_CONCURRENCY=8
MAX_CLARIFICATION_LOOPS=1
MAX_RERETRIEVAL_LOOPS=1
MAX_REPAIR_LOOPS=1

# --- 检索双增强（与批次 9 验收配置一致）---
RAPTOR_ENABLED=true
RERANK_ENABLED=true
RERANK_ENDPOINT=<<从本机 .env 抄>>

# --- 生产增强双开关 ---
RESUME_CLARIFY_ENABLED=true
RESUME_CLARIFY_MAX=2
# v3 B2：每会话解析次数上限（防烧钱；上传/预览零成本不计额）
RESUME_PARSE_LIMIT=3
# v3 B4：视觉 OCR 兜底（扫描件/图片简历；同一个 QWEN_API_KEY，按次计费约分钱级）
RESUME_OCR_ENABLED=true
QWEN_VL_MODEL=qwen-vl-ocr
VL_MAX_CONCURRENCY=2
RESUME_OCR_PAGE_MIN_CHARS=50
RESUME_OCR_MAX_PAGES=6
RESUME_OCR_MAX_PIXELS=4000000
RESUME_OCR_RENDER_SCALE=2.0
RESUME_OCR_MAX_IMAGE_PIXELS_DECODE=40000000
CONSULT_COACH_ENABLED=true
CONSULT_COACH_MAX=3
