# Career-RAG 生产 .env 模板（复制为 /opt/career-rag/app/.env 后逐项填真值）
# 带 <<>> 的必须替换；其余按需调整。

# --- 数据库（密码用 server_setup.sh 第 4 步打印的那个）---
DATABASE_URL=postgresql://career:<<DB_PASS>>@localhost:5432/career_rag
DB_POOL_MIN=2
DB_POOL_MAX=8

# --- LLM 与 Embedding（从本机 .env 抄真实 key）---
DEEPSEEK_API_KEY=<<你的key>>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-reasoner
DASHSCOPE_API_KEY=<<你的key>>
QWEN_EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# --- 检索双增强（与批次 9 验收配置一致）---
RAPTOR_ENABLED=true
RERANK_ENABLED=true
RERANK_ENDPOINT=<<从本机 .env 抄>>
RERANK_MODEL=gte-rerank-v2

# --- 生产增强双开关 ---
RESUME_CLARIFY_ENABLED=true
RESUME_CLARIFY_MAX=2
CONSULT_COACH_ENABLED=true
CONSULT_COACH_MAX=3

# --- 认证（域名 + HTTPS：全程安全 Cookie，无需任何 insecure 开关）---
AUTH_ENFORCED=true
AUTH_JWT_SECRET=<<openssl rand -hex 32 生成一个新的，别用本机的>>
AUTH_SESSION_TTL_DAYS=30
SESSION_QUOTA_PER_USER=3

# --- 邮件验证码（QQ SMTP，从本机 .env 抄；授权码答辩前记得轮换）---
EMAIL_OTP_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=<<你的QQ邮箱>>
SMTP_PASSWORD=<<QQ授权码>>
SMTP_FROM=<<你的QQ邮箱>>

# --- 其余保持默认即可 ---
